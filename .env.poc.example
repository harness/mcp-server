POC_PORT=3005
POC_PUBLIC_URL=http://127.0.0.1:3005
POC_LATER_GRANT=refresh
POC_EXTERNAL_SUB_CLAIM=external_sub
POC_VAULT_PATH=.poc/vault.json

OKTA_ISSUER=https://your-org.oktapreview.com/oauth2/default
OKTA_CLIENT_ID=<okta-client-id>
OKTA_CLIENT_SECRET=<okta-client-secret>
OKTA_SCOPES=openid profile email
# Leave unset to accept the audience Okta puts in the access token.
# OKTA_AUDIENCE=api://default

KEYCLOAK_BASE_URL=https://id.harness-test.com/idp
# Only needed when KEYCLOAK_BASE_URL is a port-forward; the browser leg must still use the public host.
# KEYCLOAK_FORWARDED_HOST=id.harness-test.com
KEYCLOAK_REALM=HarnessIDP
KEYCLOAK_CLIENT_ID=jpmc-harness-api-proxy
KEYCLOAK_CLIENT_SECRET=<keycloak-client-secret>
KEYCLOAK_IDP_HINT=okta
KEYCLOAK_SCOPES=openid profile email organization
HARNESS_API_BASE=https://mcp.harness-test.com
